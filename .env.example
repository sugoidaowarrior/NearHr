# NearHr environment variables
# Vercel: paste these into Project Settings > Environment Variables.
# The Google OAuth client must allow your Vercel URL as an authorized redirect URI
# (<your-vercel-url>/api/auth/google/callback) in Google Cloud Console.

APP_URL=https://YOUR-VERCEL-URL.vercel.app
EMPLOYER_EMAILS=your@employer.com

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NEAR network: mainnet or testnet
NEAR_NETWORK=mainnet
NEAR_NODE_URL=
NEAR_DEPLOYER_ACCOUNT=
NEAR_DEPLOYER_KEY=
NEAR_INVOICE_CONTRACT_ID=

# Server-only secrets
VAULT_APP_SECRET=
PYTH_API_KEY=
