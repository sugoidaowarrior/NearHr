# HushPay environment — copy to .env.local and fill in.

# --- App ---
APP_URL=http://localhost:3000
# Comma-separated Gmail addresses that get the employer role at first login.
EMPLOYER_EMAILS=you@gmail.com

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
# OAuth client secret
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI must include: http://localhost:3000/api/auth/google/callback

# --- NEAR ---
# mainnet | testnet
NEAR_NETWORK=testnet
# Optional explicit RPC (defaults per network)
# NEAR_NODE_URL=https://rpc.testnet.near.org

# --- NEAR AI Cloud (private expense audit, TEE verified) ---
# API key from https://cloud.near.ai/dashboard
NEAR_AI_CLOUD_API_KEY=
*** Optional: override the TEE model
# (TEE-attested: deepseek-ai/DeepSeek-V4.1-Flash-1017, deepseek/deepseek-v3.2, qwen/qwen3.5-397b-a17b)
# MODEL_NAME=
# DEMO MODE (temporary, remove before submission): if set, completions come
# from this external OpenAI-compatible provider and the proof panel is marked
# "Not verified (demo)". The live TEE attestation pipeline still runs.
# FORTYTWO_API_KEY=
***
# FORTYTWO_MODEL=qwen/qwen3.8-27b

# --- Backup email delivery (optional; MVP shows the bundle for manual send) ---
# SMTP or Resend keys can be wired into /api/vault/backup later.
# BACKUP_SENDER_EMAIL=
